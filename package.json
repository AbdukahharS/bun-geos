{
  "name": "@shzd/bun-geos",
  "version": "0.0.1",
  "description": "Bun-native TypeScript bindings for GEOS 3.14 — PostGIS-grade overlays, topology repair, and coverage algebra at native speed.",
  "module": "index.ts",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build:native": "bun run scripts/build-native.ts",
    "typecheck": "bun check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun test test/",
    "test:spike": "bun test spike/",
    "test:soak": "SOAK_SCALE=large bun test test/soak/",
    "test:native": "gcc -O1 -g -fsanitize=address,undefined -fno-omit-frame-pointer test/native/shim_selftest.c build/native/shim.so build/native/libgeos_c.so.1 -o build/native/shim_selftest -Wl,--disable-new-dtags -Wl,-rpath,$PWD/build/native && ./build/native/shim_selftest",
    "test:platform": "bun run scripts/platform-smoke.ts",
    "package:platform": "bun run scripts/package-platform.ts",
    "package:main": "bun run scripts/package-main.ts",
    "release": "bun run scripts/release.ts",
    "release:dry-run": "bun run scripts/release-dry-run.ts",
    "install:overlay": "bun run scripts/install-overlay.ts",
    "bench": "bun bench/run.ts",
    "bench:parallel": "bun bench/parallel.ts",
    "bench:report": "bun bench/report.ts",
    "bench:competitors": "bun bench/competitors/run.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
